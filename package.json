{
  "name": "ashyq-diagnostic",
  "version": "0.1.0",
  "private": true,
  "description": "ASHYQ Quick Diagnostic — быстрая диагностика IELTS / SAT (lead-gen воронка)",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "validate:bank": "tsx scripts/validate-questions.ts",
    "e2e": "tsx scripts/e2e-check.ts",
    "e2e:audio": "tsx scripts/audio-check.ts",
    "check:crm": "tsx scripts/crm-check.ts",
    "check:crm-ui": "tsx scripts/crm-ui-check.ts",
    "check:seo": "tsx scripts/seo-check.ts",
    "check:a11y-perf": "tsx scripts/a11y-perf-check.ts",
    "check:units": "tsx scripts/lms-unit-check.ts && tsx scripts/season-unit-check.ts && tsx scripts/env-check.ts && tsx scripts/telegram-check.ts && tsx scripts/crm-staff-check.ts",
    "e2e:lms": "tsx scripts/lms-e2e.ts",
    "e2e:season": "tsx scripts/season-e2e.ts",
    "check:tokens": "tsx scripts/token-audit.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@types/node": "22.10.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "10.4.20",
    "chrome-launcher": "^1.2.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "lighthouse": "^13.4.1",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "tailwindcss": "3.4.17",
    "tsx": "^4.23.13",
    "typescript": "5.7.3"
  }
}
