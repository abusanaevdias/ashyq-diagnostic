{
  "$schema": "https://tr.designtokens.org/format/draft/",
  "meta": {
    "name": "ASHYQ Design Tokens v3",
    "style": "clean premium edtech (light, airy, photo-driven)",
    "source": "uploads/image-1.png (6-page mockup), цвета семплированы",
    "replaces": "v2 poster-campaign style (docs/DESIGN.md) для продуктового сайта"
  },
  "color": {
    "bg": { "$value": "#F8F7F3", "$description": "тёплый off-white фон всех страниц" },
    "surface": { "$value": "#FDFDFD", "$description": "белые карточки, инпуты, футер-подложки" },
    "blush": { "$value": "#F9E0DB", "$description": "розовые CTA-полосы, подложки icon-chip, бейджи" },
    "blushSoft": { "$value": "#FCF3F0", "$description": "ховер/заливка лёгких красных элементов" },
    "red": { "$value": "#DE0B1B", "$description": "акцент: кнопки, иконки, ссылки, цифры, графики" },
    "redDeep": { "$value": "#B60916", "$description": "hover/pressed красного" },
    "ink": { "$value": "#161311", "$description": "заголовки и основной текст" },
    "inkSoft": { "$value": "#6E6D6B", "$description": "вторичный текст, описания" },
    "inkMuted": { "$value": "#8C8B8A", "$description": "мета-текст, подписи, плейсхолдеры" },
    "hairline": { "$value": "#EFEEEA", "$description": "тонкие разделители, бордеры карточек" },
    "dark": { "$value": "#1B1512", "$description": "тёмная CTA-полоса, тёмные карточки-цитаты" },
    "darkWarm": { "$value": "#241D16", "$description": "тёмные карточки с фото/цитатой" },
    "onRed": { "$value": "#FFFFFF", "$description": "текст на красном" },
    "onDark": { "$value": "#F8F7F3", "$description": "текст на тёмном" }
  },
  "typography": {
    "fontDisplay": { "$value": "'Manrope', system-ui, sans-serif", "$weights": [700, 800] },
    "fontBody": { "$value": "'Inter', system-ui, sans-serif", "$weights": [400, 500, 600] },
    "fontScript": { "$value": "'Caveat', cursive", "$weights": [600, 700] },
    "scale": {
      "displayXl": { "size": "clamp(2.6rem, 6vw, 4.6rem)", "lineHeight": 1.04, "letterSpacing": "-0.02em", "weight": 800 },
      "displayL": { "size": "clamp(2rem, 4.6vw, 3.4rem)", "lineHeight": 1.08, "letterSpacing": "-0.02em", "weight": 800 },
      "h2": { "size": "clamp(1.5rem, 3vw, 2.2rem)", "lineHeight": 1.15, "letterSpacing": "-0.01em", "weight": 700 },
      "h3": { "size": "clamp(1.15rem, 2vw, 1.45rem)", "lineHeight": 1.25, "weight": 700 },
      "bodyL": { "size": "1.0625rem", "lineHeight": 1.6, "weight": 400 },
      "body": { "size": "0.9375rem", "lineHeight": 1.6, "weight": 400 },
      "small": { "size": "0.8125rem", "lineHeight": 1.5, "weight": 400 },
      "micro": { "size": "0.6875rem", "lineHeight": 1.3, "letterSpacing": "0.14em", "weight": 600, "transform": "uppercase" },
      "stat": { "size": "clamp(1.6rem, 3vw, 2.2rem)", "lineHeight": 1, "weight": 800 },
      "script": { "size": "clamp(1.4rem, 2.6vw, 2rem)", "lineHeight": 1.2, "weight": 600 }
    }
  },
  "radius": {
    "xs": { "$value": "8px", "$use": "icon-chip, маленькие бейджи" },
    "sm": { "$value": "12px", "$use": "инпуты, маленькие карточки" },
    "md": { "$value": "16px", "$use": "фото, карточки списка" },
    "lg": { "$value": "20px", "$use": "карточки курсов, прогресс-карта" },
    "xl": { "$value": "24px", "$use": "крупные карточки, полосы-карточки" },
    "pill": { "$value": "999px", "$use": "кнопки, чипсы фильтров" },
    "circle": { "$value": "50%", "$use": "кнопка-стрелка, аватары" }
  },
  "spacing": {
    "container": { "$value": "1200px", "$pad": "24px" },
    "sectionY": { "desktop": "96px", "mobile": "56px" },
    "blockGap": { "desktop": "48px", "mobile": "32px" },
    "cardPad": { "desktop": "28px", "mobile": "20px" },
    "gridGap": { "desktop": "24px", "mobile": "16px" }
  },
  "shadow": {
    "card": { "$value": "0 10px 30px rgba(22, 19, 17, 0.06)" },
    "cardHover": { "$value": "0 16px 40px rgba(22, 19, 17, 0.10)" },
    "pill": { "$value": "0 6px 18px rgba(222, 11, 27, 0.25)" }
  },
  "border": {
    "hairline": { "$value": "1px solid #EFEEEA" },
    "focus": { "$value": "2px solid #DE0B1B", "offset": "3px" }
  },
  "motion": {
    "fast": { "$value": "150ms", "easing": "cubic-bezier(0.2, 0.7, 0.2, 1)" },
    "base": { "$value": "220ms", "easing": "cubic-bezier(0.2, 0.7, 0.2, 1)" },
    "enter": { "$value": "fade + translateY(10px), 260ms" },
    "hoverButton": { "$value": "translateY(-1px) + shadow, arrow shift +2px" }
  },
  "iconography": {
    "style": "line icons, stroke 1.6px, round caps",
    "chipLight": "blush #F9E0DB фон + red глиф, radius 8px, 40x40",
    "chipSolid": "red #DE0B1B фон + white глиф, radius 8px, 40x40",
    "circleArrow": "red круг 44px + white стрелка →, hover: светлее + сдвиг"
  },
  "photography": {
    "style": "реальные тёплые фото: студенты, кампусы, интерьеры, ноутбуки; мягкий свет, плёночное зерно не нужно",
    "treatment": "без фильтров и ч/б; радиус 16px; объект-центричные кропы"
  }
}

