# ---------------------------------------------------------------------------
# ASHYQ Quick Diagnostic — настройки окружения
# Скопируй в .env.local и заполни. Без этих переменных приложение работает,
# но заявки будут видны только в файле .data/leads.jsonl.
# Прод: docs/DEPLOY.md. При старте сервер проверяет эти значения и пишет
# в лог «[ashyq env] …»; при ошибке конфигурации /api/health отвечает 503.
# NEXT_PUBLIC_* вшиваются при сборке (npm run build / docker build).
# ---------------------------------------------------------------------------

# WhatsApp-номер Ashyq в международном формате: без "+", пробелов и скобок.
NEXT_PUBLIC_ASHYQ_WHATSAPP=77067080181

# Публичный адрес сайта — нужен для canonical, Open Graph, sitemap и robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Куда падают заявки -----------------------------------------------------

# Telegram-уведомление о каждой новой заявке (самый удобный канал).
# 1. Создай бота у @BotFather -> получишь токен.
# 2. Напиши боту любое сообщение, затем открой
#    https://api.telegram.org/bot<ТОКЕН>/getUpdates и возьми оттуда chat.id
ASHYQ_TELEGRAM_BOT_TOKEN=
ASHYQ_TELEGRAM_CHAT_ID=
# Тема в супергруппе с темами (forum). Пусто — General.
# Число из ссылки на сообщение в теме: t.me/c/<группа>/<ТЕМА>/<сообщение>
ASHYQ_TELEGRAM_THREAD_ID=
# CRM внутри Telegram (Mini App): @BotFather -> /newapp -> этот бот,
# Web App URL: https://<домен>/crm, short name: crm. Сюда — выданная ссылка
# вида https://t.me/<бот>/crm. Под каждой заявкой появится «Открыть в CRM».
# Пускает участников группы ASHYQ_TELEGRAM_CHAT_ID без ключа админа.
ASHYQ_TELEGRAM_APP_URL=
# Кнопки этапов под заявкой и команды /new /today /find /stats /crm.
# 1. openssl rand -hex 32 -> сюда, Redeploy.
# 2. Один раз: curl -X PUT https://<домен>/api/telegram -H "x-ashyq-admin-key: <ASHYQ_ADMIN_KEY>"
# 3. Сделай бота админом группы, иначе в группе он видит только /команда@бот.
ASHYQ_TELEGRAM_WEBHOOK_SECRET=
# Утренняя сводка в 9:00 и напоминание о заявке, которую не взяли за 15 минут.
# openssl rand -hex 32 -> сюда и в расписание Supabase (docs/DEPLOY.md, «Расписание бота»).
CRON_SECRET=

# Любой внешний приёмник JSON: Google Apps Script, Make, n8n, CRM.
# Обязательно https — иначе телефон уйдёт открытым текстом и запрос не выполнится.
ASHYQ_LEAD_WEBHOOK_URL=

# 1 — слать уведомление даже про тех, кто просто дошёл до результата
# и не оставил контакт. По умолчанию такие пишутся только в файл.
ASHYQ_NOTIFY_ALL=

# --- Выгрузка собранных заявок ---------------------------------------------

# Длинный случайный ключ, не короче 32 символов: openssl rand -hex 32.
# Пока он не задан, /api/leads и /crm отвечают 404,
# чтобы база телефонов не оказалась в открытом доступе. CRM: /crm.
# Выгрузка: GET /api/leads?format=csv&contacts=1 с заголовком
# x-ashyq-admin-key: КЛЮЧ (в URL ключ не принимается — он попал бы в логи).
ASHYQ_ADMIN_KEY=

# Куда складывать .jsonl с заявками (по умолчанию ./.data).
# На хостингах с read-only диском (Vercel) укажи /tmp или полагайся на Telegram.
ASHYQ_LEADS_DIR=

# --- Хранение заявок в Supabase (необязательно) ------------------------------
# supabase — заявки, журнал доставки и события CRM пишутся в Supabase вместо
# файлов (схема и RLS — docs/SUPABASE_FOUNDATION.md). Пусто — файлы.
# URL — только https (http допускается для локального Supabase на localhost).
# Ключ service role — только на сервере, никогда не в NEXT_PUBLIC_*.
# Vercel + официальная интеграция Supabase: её SUPABASE_URL и SUPABASE_SERVICE_ROLE_KEY
# подхватываются сами, и на Vercel заявки уходят в Supabase без этих трёх строк.
ASHYQ_LEADS_PROVIDER=
ASHYQ_SUPABASE_URL=
ASHYQ_SUPABASE_SERVICE_ROLE_KEY=

# --- Вход и учебный кабинет через Supabase (необязательно) -------------------
# supabase — настоящие аккаунты: почта + пароль, регистрация с согласием родителя
# до 18 лет, роли учителя/автора выдаёт админ. Пусто или demo — демо-вход в браузере.
# Задаются ПРИ СБОРКЕ (NEXT_PUBLIC_*). Ключ — anon/publishable, не service role.
# Локально: адрес и ANON_KEY из `npx supabase@2.117.0 status -o env`.
NEXT_PUBLIC_AUTH_PROVIDER=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
