# ---------------------------------------------------------------------------
# ASHYQ Quick Diagnostic — настройки окружения
# Скопируй в .env.local и заполни. Без этих переменных приложение работает,
# но заявки будут видны только в файле .data/leads.jsonl.
# ---------------------------------------------------------------------------

# WhatsApp-номер Ashyq в международном формате: без "+", пробелов и скобок.
NEXT_PUBLIC_ASHYQ_WHATSAPP=77067080181

# Публичный адрес сайта — нужен для canonical, Open Graph, sitemap и robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Куда падают заявки -----------------------------------------------------

# Telegram-уведомление о каждой новой заявке (самый удобный канал).
# 1. Создай бота у @BotFather -> получишь токен.
# 2. Напиши боту любое сообщение, затем открой
#    https://api.telegram.org/bot<ТОКЕН>/getUpdates и возьми оттуда chat.id
ASHYQ_TELEGRAM_BOT_TOKEN=
ASHYQ_TELEGRAM_CHAT_ID=

# Любой внешний приёмник JSON: Google Apps Script, Make, n8n, CRM.
# Обязательно https — иначе телефон уйдёт открытым текстом и запрос не выполнится.
ASHYQ_LEAD_WEBHOOK_URL=

# 1 — слать уведомление даже про тех, кто просто дошёл до результата
# и не оставил контакт. По умолчанию такие пишутся только в файл.
ASHYQ_NOTIFY_ALL=

# --- Выгрузка собранных заявок ---------------------------------------------

# Длинный случайный ключ. Пока он не задан, /api/leads и /crm отвечают 404,
# чтобы база телефонов не оказалась в открытом доступе. CRM: /crm.
# Выгрузка: GET /api/leads?format=csv&contacts=1 с заголовком
# x-ashyq-admin-key: КЛЮЧ (в URL ключ не принимается — он попал бы в логи).
ASHYQ_ADMIN_KEY=

# Куда складывать .jsonl с заявками (по умолчанию ./.data).
# На хостингах с read-only диском (Vercel) укажи /tmp или полагайся на Telegram.
ASHYQ_LEADS_DIR=
